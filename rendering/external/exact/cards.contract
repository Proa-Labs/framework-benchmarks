shape Card
  dataCardId: string
  title: string
  features: string[]
shape Section
  dataSection: string
  title: string
  cards: Card[]

style Hero
  padding="12px 0" border-bottom-width=1 border-bottom-style="solid" border-bottom-color="#dce1e8"
style Title
  font-size=26 margin="0 0 12px"
style Muted
  color="#64748b" margin="8px 0"
style SectionTitle
  font-size=20
style Grid
  display="grid" grid-template-columns="repeat(4, minmax(0, 1fr))" gap=16
style Card
  border-width=1 border-style="solid" border-color="#dce1e8" border-radius=8 background-color="#ffffff" overflow="hidden"
style CardBody
  padding=14
style CardImage
  width="100%" height=92 object-fit="cover" background-color="#e9eef5"
style CardTitle
  margin=0 font-size=15
style Description
  margin="8px 0"
style Features
  padding-left=18 font-size=12
style Button
  border-width=0 background-color="#334155" color="#ffffff" padding="7px 10px" border-radius=4
style Footer
  padding="12px 0" color="#64748b"

component App
  resource sections = prepared() as shape Section[] else empty()
  view
    view
      header class=Hero
        h1 class=Title
          text "SSR Framework Benchmark"
        text "Comparing Proa, Leptos, Dioxus, and Yew" class=Muted
      main
        for section, sectionIndex in sections key=sectionIndex
          section data-section=section.dataSection
            h2 class=SectionTitle
              text section.title
            view class=Grid
              for card, cardIndex in section.cards key=cardIndex
                article class=Card data-card-id=card.dataCardId
                  view
                    image "/images/benchmark.png" alt="Benchmark chart" class=CardImage
                  view class=CardBody
                    h3 class=CardTitle
                      text card.title
                    text "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua." class=Description
                    view role="list" class=Features
                      for feature, featureIndex in card.features key=featureIndex
                        text feature role="listitem"
                    button class=Button
                      text "View Details"
      footer class=Footer
        text "Rendered by the SSR benchmark fixture"
