{
  "rendering": {
    "entry": "benchmarks/rendering/canonical/run.mjs",
    "directory": "benchmarks/rendering",
    "view": "rendering",
    "title": "Render to fresh owned native output",
    "contract": "benchmarks/rendering/canonical/workloads.json",
    "smoke": [
      "--smoke"
    ],
    "report": "benchmarks/rendering/generate-report.mjs",
    "requires": [
      "git",
      "tar",
      "Chromium",
      "adapter toolchain"
    ],
    "options": {
      "renderers": "value",
      "workloads": "value",
      "repeats": "value",
      "out": "value",
      "no-setup": "flag",
      "setup-only": "flag",
      "parity-only": "flag",
      "product-scaling": "flag",
      "refresh-proa": "flag"
    }
  },
  "framework": {
    "entry": "benchmarks/framework-ssr/run.ts",
    "directory": "benchmarks/framework-ssr",
    "view": "framework",
    "title": "Full framework request pipeline",
    "contract": "benchmarks/framework-ssr/contract.json",
    "smoke": [
      "--smoke"
    ],
    "report": "benchmarks/framework-ssr/report.ts",
    "requires": [
      "git",
      "tar",
      "cargo",
      "Bun",
      "Exact pinned source"
    ],
    "options": {
      "proa-only": "flag",
      "out": "value",
      "workers": "value",
      "no-build": "flag",
      "parity-only": "flag"
    }
  },
  "http": {
    "entry": "benchmarks/http/run.mjs",
    "directory": "benchmarks/http",
    "view": "http",
    "title": "HTTP capacity and fixed-load latency",
    "contract": "benchmarks/http/scenario.mjs",
    "smoke": [
      "--duration",
      "1",
      "--repeats",
      "1",
      "--warmup-requests",
      "4",
      "--concurrency",
      "8"
    ],
    "report": "benchmarks/http/report.mjs",
    "requires": [
      "git",
      "tar",
      "cargo",
      "go",
      "Bun"
    ],
    "options": {
      "out": "value",
      "engines": "value",
      "workloads": "value",
      "duration": "value",
      "repeats": "value",
      "warmup-requests": "value",
      "concurrency": "value",
      "pre-roll": "value",
      "workers": "value",
      "no-build": "flag",
      "tolerate-generator-limits": "flag"
    }
  },
  "streaming": {
    "entry": "benchmarks/streaming/run.mjs",
    "directory": "benchmarks/streaming",
    "view": "streaming",
    "title": "Suspense streaming across offered loads",
    "contract": "benchmarks/streaming/scenario.mjs",
    "smoke": [
      "--rates",
      "20,50",
      "--duration",
      "1",
      "--repeats",
      "1",
      "--warmup-requests",
      "4"
    ],
    "report": "benchmarks/streaming/report.mjs",
    "requires": [
      "git",
      "tar",
      "cargo",
      "Bun"
    ],
    "options": {
      "out": "value",
      "engines": "value",
      "rates": "value",
      "duration": "value",
      "repeats": "value",
      "warmup-requests": "value",
      "boundaries": "value",
      "cards-per-panel": "value",
      "pre-roll": "value",
      "workers": "value"
    }
  },
  "startup": {
    "entry": "benchmarks/cold-start/run.mjs",
    "directory": "benchmarks/cold-start",
    "view": "startup",
    "title": "Process spawn to first complete response",
    "contract": "benchmarks/cold-start/run.mjs",
    "smoke": [
      "--starts",
      "2",
      "--warmup-starts",
      "1"
    ],
    "report": "benchmarks/cold-start/report.mjs",
    "requires": [
      "git",
      "tar",
      "cargo",
      "go",
      "Bun"
    ],
    "options": {
      "out": "value",
      "engines": "value",
      "starts": "value",
      "warmup-starts": "value",
      "no-build": "flag"
    }
  }
}
