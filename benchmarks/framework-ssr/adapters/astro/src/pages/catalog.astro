---
import cards from "../../cards.json";
export const prerender = false;
const request = Astro.url.searchParams.get("request") || "";
Astro.response.headers.set("cache-control", "no-store");
---
<!doctype html><html lang="en"><head><title>Framework catalog benchmark</title></head><body><main data-bench-page="catalog"><h1>Product catalog</h1><div data-bench-request="true">{request}</div>{cards.map(card => <article data-bench-card={card.id}>
<h2 data-bench-title={card.id}>{card.title}</h2>
<div data-bench-category={card.id}>{card.category}</div>
<div data-bench-description={card.id}>{card.description}</div>
<div data-bench-price={card.id}>{`$${(card.priceCents / 100).toFixed(2)}`}</div>
<div data-bench-stock={card.id}>{card.inStock ? 'In stock' : 'Out of stock'}</div>
<div role="list" aria-label="Tags" data-bench-tags={card.id}>{card.tags.map(tag => <div role="listitem">{tag}</div>)}</div>
</article>)}</main></body></html>
