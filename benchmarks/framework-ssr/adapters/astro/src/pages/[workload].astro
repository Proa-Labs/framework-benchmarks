---
import { titles, type Workload } from "../../../../workloads.ts";
export const prerender = false;
const workload = Astro.params.workload as Workload;
if (!Object.hasOwn(titles, workload))
  return new Response("Not found", { status: 404 });
const request = Astro.url.searchParams.get("request") || "";
Astro.response.headers.set("cache-control", "no-store");
---
<!doctype html><html lang="en"><head><title>{titles[workload]}</title></head><body><main data-bench-page={workload}><h1>{titles[workload]}</h1><div data-bench-request="true">{request}</div>
{workload==="cards"?sections.map(section=><section data-bench-section={section.id}><h2>{section.title}</h2>{section.cards.map(card=><article data-bench-card={card.id}><h3>{card.title}</h3><div data-bench-description={card.id}>{card.description}</div><div role="list" aria-label="Features">{card.features.map(feature=><div role="listitem">{feature}</div>)}</div></article>)}</section>):workload==="products"?products.map(product=><article data-bench-product={product.id}><a href={`/products/${product.id}`}><h2>{product.name}</h2></a><div>{product.category}</div><div>{money(product.priceCents)}</div><div>{(product.ratingTenths/10).toFixed(1)} ({product.reviewCount})</div><div aria-label="Rating">{starIndexes.map(index=><svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-filled={index<Math.floor((product.ratingTenths+5)/10)?"true":"false"}><path d={starPath}/></svg>)}</div></article>):<table><caption>Customer Accounts</caption><thead><tr>{headers.map(header=><th scope="col">{header}</th>)}</tr></thead><tbody>{rows.map(row=><tr data-bench-row={row.id}><td>{row.id}</td><td>{row.name}</td><td>{row.email}</td><td data-active={row.status==="Active"?"true":"false"}>{row.status}</td><td>{money(row.amountCents)}</td><td>{money(row.taxCents)}</td><td>{money(row.amountCents+row.taxCents)}</td><td>{date(row.createdUnix)}</td><td>{timestamp(row.updatedUnix)}</td><td>{score(row.scoreBps)}</td><td>{row.country}</td><td><div role="list" aria-label="Tags">{row.tags.map(tag=><div role="listitem">{tag}</div>)}</div></td></tr>)}</tbody></table>}</main></body></html>
