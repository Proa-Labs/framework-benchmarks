#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKSPACE_DIR="$(cd "$SCRIPT_DIR/../.." && pwd)"

if [ -n "${CANONICAL_SUITE_BUN:-}" ] && [ -x "$CANONICAL_SUITE_BUN" ]; then
    NODE_BIN="$CANONICAL_SUITE_BUN"
elif [ -x "$WORKSPACE_DIR/node_modules/.bin/bun" ]; then
    NODE_BIN="$WORKSPACE_DIR/node_modules/.bin/bun"
else
    NODE_BIN="$(command -v bun)"
fi
if [ "$($NODE_BIN --version)" != "1.4.2" ]; then
    echo "Canonical suite requires Bun 1.4.2; set CANONICAL_SUITE_BUN." >&2
    exit 1
fi

cd "$WORKSPACE_DIR"
exec "$NODE_BIN" benchmarks/rendering/canonical/run.mjs "$@"
