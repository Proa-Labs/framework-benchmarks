{
  "name": "frameworks-run-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TanStack Start + Tailwind website with Cloudflare SSR, built from validated benchmark captures.",
  "scripts": {
    "build": "bun build.ts",
    "dev": "bun dev.ts",
    "test": "bun prepare-data.ts && bun test test",
    "test:browser": "bun test/browser.ts",
    "deploy:check": "bun run build && wrangler deploy --dry-run",
    "deploy": "bun ../tooling/publication.mjs && bun run build && wrangler deploy",
    "typecheck": "bun prepare-data.ts && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "react": "catalog:site",
    "react-dom": "catalog:site",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/d3-array": "3.2.2",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.2.0",
    "@types/react": "catalog:",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.0",
    "playwright": "catalog:",
    "vite": "catalog:",
    "wrangler": "4.160.1",
    "proa-bench-react": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.2",
    "node": ">=22.12.0"
  }
}
