{
  "name": "frameworks-run-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The frameworks.run website, built from this repository's benchmark captures.",
  "scripts": {
    "build": "bun build.mjs",
    "dev": "bun dev.mjs",
    "test": "bun prepare-data.mjs && bun test test",
    "test:browser": "bun test/browser.mjs",
    "deploy:check": "bun run build && wrangler deploy --dry-run",
    "deploy": "bun run build && wrangler deploy",
    "lint": "biome check ."
  },
  "dependencies": {
    "d3-array": "3.2.4",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright": "1.61.1",
    "vite": "8.3.4",
    "wrangler": "4.159.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2"
}
