routes nav
  cards "/cards" render=request
  products "/products" render=request
  table "/table" render=request
  notfound render=request

shape Card
  id: string
  title: string
  description: string
  features: string[]

shape Section
  id: string
  title: string
  cards: Card[]

shape Product
  id: number
  name: string
  category: string
  priceCents: number
  ratingTenths: number
  reviewCount: number

shape Account
  id: number
  name: string
  email: string
  status: string
  amountCents: number
  taxCents: number
  createdUnix: number
  updatedUnix: number
  scoreBps: number
  country: string
  tags: string[]

component App
  derive route = top(nav).name
  resource sections = loadSections(route) as shape Section[] else empty()
  resource products = loadProducts(route) as shape Product[] else empty()
  resource rows = loadRows(route) as shape Account[] else empty()
  derive request = searchParam(top(nav), "request")
  view
    main navigationKey=route data-bench-page=route
      h1
        if route == "cards"
          text "SSR Framework Benchmark"
        else if route == "products"
          text "All products"
        else
          text "Customer Accounts"
      text request data-bench-request="true"
      if route == "cards"
        Cards(sections=sections)
      else if route == "products"
        Products(products=products)
      else if route == "table"
        Accounts(rows=rows)

component Cards
  props
    sections: Section[]
  view
    view
      for section in sections key=section.id
        section data-bench-section=section.id
          h2
            text section.title
          for card in section.cards key=card.id
            article data-bench-card=card.id
              h3
                text card.title
              text card.description data-bench-description=card.id
              view role="list" aria-label="Features"
                for feature in card.features key=feature
                  text feature role="listitem"

component Products
  props
    products: Product[]
  view
    view
      for product in products key=product.id
        article data-bench-product=product.id
          link href=`/products/${product.id}`
            h2
              text product.name
          text product.category
          text `$${formatDecimal(product.priceCents, 2)}`
          text `${formatDecimal(product.ratingTenths, 1)} (${product.reviewCount})`
          view aria-label="Rating"
            for index in [0, 1, 2, 3, 4] key=index
              svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" data-filled=(index < floor((product.ratingTenths + 5) / 10) ? "true" : "false")
                path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.539 1.118l-2.8-2.034a1 1 0 00-1.176 0l-2.8 2.034c-.783.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.363-1.118l-2.8-2.034c-.784-.57-.381-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"

component Accounts
  props
    rows: Account[]
  view
    table
      caption
        text "Customer Accounts"
      thead
        tr
          for label in ["ID", "Name", "Email", "Status", "Amount", "Tax", "Total", "Created", "Updated", "Score", "Country", "Tags"] key=label
            th scope="col"
              text label
      tbody
        for account in rows key=account.id
          tr data-bench-row=account.id
            td
              text `${account.id}`
            td
              text account.name
            td
              text account.email
            td data-active=(account.status == "Active" ? "true" : "false")
              text account.status
            td
              text `$${formatDecimal(account.amountCents, 2)}`
            td
              text `$${formatDecimal(account.taxCents, 2)}`
            td
              text `$${formatDecimal(account.amountCents + account.taxCents, 2)}`
            td
              text formatDate(account.createdUnix * 1000, 0, "iso")
            td
              text `${formatDate(account.updatedUnix * 1000, 0, "iso")} ${formatTime(account.updatedUnix * 1000, 0, "short")}`
            td
              text `${formatDecimal(floor(account.scoreBps / 10), 1)}%`
            td
              text account.country
            td
              view role="list" aria-label="Tags"
                for tag in account.tags key=tag
                  text tag role="listitem"
